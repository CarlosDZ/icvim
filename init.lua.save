vim.cmd [[packadd packer.nvim]]  -- Cargar Packer
vim.opt.rtp:prepend("~/.config/nvim/lazy/lazy.nvim") --Cargar Lazy Vim

-- Usamos Packer para gestionar los plugins
require('packer').startup(function(use)

  -- Packer como plugin para que se gestione a sí mismo
  use 'wbthomason/packer.nvim'

  -- Plugins básicos
  use 'tpope/vim-sensible'             -- Configuraciones básicas sensatas
  use 'nvim-treesitter/nvim-treesitter'  -- Resaltado de sintaxis avanzado
  use 'hrsh7th/nvim-cmp'               -- Autocompletado inteligente
  use 'neovim/nvim-lspconfig'          -- Configuración del LSP
  use 'L3MON4D3/LuaSnip'               -- Snippets de código

  use 'gruvbox-community/gruvbox'      -- Tema de colores oscuro

  -- Explorador de archivos
  use 'kyazdani42/nvim-tree.lua'      -- Nvim Tree para explorar archivos

  -- Línea de estado
  use 'hoob3rt/lualine.nvim'          -- Lualine para una barra de estado bonita

  -- Otras utilidades
  use 'windwp/nvim-autopairs'         -- Auto cierra paréntesis, corchetes, etc.
  use 'lewis6991/gitsigns.nvim'       -- Muestra cambios de Git en las líneas
end)

--Plugins de lazy
require("lazy").setup({
  -- LSP y autocompletado
  "neovim/nvim-lspconfig",
  "hrsh7th/nvim-cmp",
  "hrsh7th/cmp-nvim-lsp",
  "onsails/lspkind.nvim",          -- Íconos bonitos para autocompletado
  "jose-elias-alvarez/null-ls.nvim",

  -- HTML/CSS/JS específico
  "Jezda1337/nvim-html-css",        -- HTML/CSS helpers
  "mattn/emmet-vim",                -- Abreviaciones tipo Emmet

  -- Interfaz y calidad de vida
  "nvim-treesitter/nvim-treesitter",
  "nvim-telescope/telescope.nvim",
})

-- Configuración general
vim.opt.number = true               -- Mostrar números de línea
vim.opt.relativenumber = true       -- Números relativos
vim.opt.tabstop = 4                 -- Tamaño de tabulación
vim.opt.shiftwidth = 4              -- Indentación con 4 espacios
vim.opt.expandtab = true            -- Convertir tabulaciones a espacios
vim.opt.smartindent = true          -- Activar indentación automática
vim.opt.wrap = false                -- No ajustar el texto automáticamente
vim.opt.ignorecase = true           -- Ignorar mayúsculas/minúsculas en búsquedas
vim.opt.smartcase = true            -- Activar la sensibilidad a mayúsculas si hay mayúsculas en la búsqueda
vim.opt.incsearch = true            -- Buscar mientras escribes
vim.opt.hlsearch = true             -- Resaltar resultados de búsqueda

-- Desactivar el sonido de las campanas de advertencia
vim.opt.errorbells = false

-- Mostrar lineas de comando
vim.opt.showmode = false            -- No mostrar el modo en la línea de estado (es innecesario)


-- Configurar Nvim Tree
require("lazy").setup({
  {
    "nvim-tree/nvim-tree.lua",
    dependencies = { "nvim-tree/nvim-web-devicons" }, -- íconos opcionales
    config = function()
      vim.g.loaded_netrw = 1
      vim.g.loaded_netrwPlugin = 1
      vim.opt.termguicolors = true
      require("nvim-tree").setup()
    end,
  }
})


-- Atajo para abrir y cerrar el explorador de archivos
vim.api.nvim_set_keymap('n', '<leader>e', ':NvimTreeToggle<CR>', { noremap = true, silent = true })

-- Configuración de Lualine
require('lualine').setup {
  options = {
    theme = 'gruvbox',  -- Puedes cambiar el tema aquí
    section_separators = {'', ''},
    component_separators = {'', ''},
  },
}

-- Atajo para guardar archivo
vim.api.nvim_set_keymap('n', '<leader>w', ':w<CR>', { noremap = true, silent = true })

-- Atajo para cerrar archivo
vim.api.nvim_set_keymap('n', '<leader>q', ':q<CR>', { noremap = true, silent = true })

-- Atajo para cortar (Eliminar) una línea
vim.api.nvim_set_keymap('n', '<leader>d', 'dd', { noremap = true, silent = true })
